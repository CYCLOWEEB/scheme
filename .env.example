# Server-only keys. Copy this file to .env.local and restart the app.
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_TEXT_MODELS=openai/gpt-oss-20b
SARVAM_API_KEY=
AI_ENABLED=true
GEMINI_TEXT_MODELS=gemini-3.5-flash-lite
AI_TEXT_PRIMARY=gemini
AI_SARVAM_TEXT_FALLBACK=false
AI_MAX_CALLS_PER_DAY=60
AI_GEMINI_RPM=3
AI_GEMINI_TTS_RPM=2
AI_GEMINI_TPM=12000
AI_GEMINI_RPD=20
AI_SARVAM_MAX_ESTIMATED_RUPEES=50

# Optional private document storage; separate from the AI tools.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
